#!/usr/bin/env bash
# ============================================================
# check — AIOS Framework 环境健康检查
# ============================================================
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
GREEN='\033[0;32m'; RED='\033[0;31m'; YELLOW='\033[1;33m'; NC='\033[0m'
ok()  { echo -e "${GREEN}✓${NC} $1"; }
warn(){ echo -e "${YELLOW}⚠${NC} $1"; }
err() { echo -e "${RED}✗${NC} $1"; errors=$((errors+1)); }

echo -e "${YELLOW}══════ AIOS Framework 健康检查 ══════${NC}"
errors=0

# 1. 核心目录
for d in aios/governance aios/execution aios/cognition aios/context aios/memory agents; do
  [ -d "$ROOT/$d" ] && ok "$d" || err "$d 缺失"
done

# 2. 核心文件
for f in AGENTS.md aios/governance/task-policy.md aios/governance/security-policy.md aios/execution/engine.md; do
  [ -f "$ROOT/$f" ] && ok "$f" || err "$f 缺失"
done

# 3. Agent 角色
for r in manager analyst architect coder reviewer tester researcher; do
  [ -f "$ROOT/agents/$r/role.md" ] && ok "agents/$r" || warn "agents/$r 缺失"
done

# 4. 运行时目录
for d in runtime/tasks runtime/states runtime/reviews runtime/verification; do
  [ -d "$ROOT/$d" ] && ok "$d" || warn "$d 缺失"
done

# 5. CLI 可执行
for c in cli/task cli/init cli/check; do
  [ -x "$ROOT/$c" ] && ok "$c (可执行)" || warn "$c 不可执行"
done

# 5b. 新增入口
[ -d "$ROOT/.pi" ] && ok ".pi/" || warn ".pi/ 缺失"
[ -d "$ROOT/.claude/rules" ] && ok ".claude/rules/" || warn ".claude/rules/ 缺失"
[ -d "$ROOT/.cursor/rules" ] && ok ".cursor/rules/" || warn ".cursor/rules/ 缺失"

# 6. 任务模板
[ -f "$ROOT/runtime/tasks/TASK.template.md" ] && ok "runtime/tasks/TASK.template.md" || err "任务模板缺失"

# 7. 入口文件
[ -f "$ROOT/AGENTS.md" ] && ok "AGENTS.md" || warn "AGENTS.md 缺失"
if [ -L "$ROOT/CLAUDE.md" ]; then ok "CLAUDE.md (symlink→AGENTS.md)"; else warn "CLAUDE.md 不是 symlink"; fi

echo -e "${YELLOW}════════════════════════════════════${NC}"
if [ $errors -eq 0 ]; then
  echo -e "${GREEN}✓ 框架完整${NC}"
  exit 0
else
  echo -e "${RED}✗ $errors 个问题${NC}"
  exit 1
fi
