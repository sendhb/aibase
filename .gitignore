# AIOS Framework — 通用忽略规则

# Dependencies
node_modules/
vendor/

# Build outputs
dist/
dist-ssr/
build/
*.local

# Editor
.idea
.DS_Store
*.sw?

# Env / secrets
.env
.env.*
!.env.example
agent.json

# Testing
coverage/
*.lcov

# Temp
*.tmp
*.temp
.cache/

# AI runtime generated data (keep directory structure, templates, and state files)
runtime/tasks/TASK-*.md
runtime/tasks/INDEX.md
runtime/executions/*
runtime/reviews/REVIEW-*.md
runtime/states/CURRENT_FOCUS.md
runtime/states/PROGRESS.md
runtime/states/STATE-*.md
runtime/states/BLOCKERS.md
runtime/verification/VERIFY-*.md
runtime/logs/*
runtime/locks/*
runtime/memory/*

# Python 编译缓存
__pycache__/
*.pyc

# AI agent 运行时状态
.codewhale/
